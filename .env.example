# P의 여행수첩 설정 파일 예시
# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤, 아래 값을 자기 키로 채우세요.
# .env 파일은 다른 사람에게 보내거나 인터넷에 올리지 마세요.

# [필수·유료] OpenAI API 키 — AI 일정 짜기, 예약 안내문 읽기, 여행 자료 검색에 사용
OPENAI_API_KEY=
# 사용할 OpenAI 모델 (구조화 출력과 이미지 읽기를 지원하는 모델)
OPENAI_MODEL=gpt-4o-mini
# 여행 자료 검색용 임베딩 모델
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# [필수·무료 한도] 카카오 REST API 키 — 장소 검색, 블로그 언급 수, 자동차 길찾기·택시비
KAKAO_REST_API_KEY=

# 카카오에서 못 찾은 장소를 OpenStreetMap에서 보완 검색 (무료, 키 없음). 끄려면 false
OSM_ENABLED=true

# 서버 포트 (8000을 다른 프로그램이 쓰고 있으면 8001 등으로 변경)
APP_PORT=8000

# [선택] 인터넷 공개 체험용 설정 (README의 "인터넷으로 잠깐 공개하기" 참고)
# 이 시각(내 컴퓨터 시간)이 지나면 모든 화면과 API가 "체험 기간이 끝났어요"로 바뀜. 비워두면 제한 없음
PUBLIC_UNTIL=
# DB 폴더 이름. 공개 체험 때는 data-public 처럼 따로 두면 내 여행 기록이 보이지 않음
APP_DATA_DIR=data
